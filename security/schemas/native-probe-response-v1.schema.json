{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peritus.invalid/schemas/security/native-probe-response-v1.schema.json",
  "title": "Peritus H0 native probe response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "request_sha256",
    "probe_id",
    "outcome",
    "native_sandbox_observed",
    "usage",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "probe_id": {"type": "string", "pattern": "^h0\\."},
    "outcome": {"enum": ["passed", "failed", "unsupported"]},
    "native_sandbox_observed": {"type": "boolean"},
    "usage": {"$ref": "#/$defs/usage"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9._-]+$"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_millis",
        "process_count",
        "peak_memory_bytes",
        "output_bytes",
        "artifact_count"
      ],
      "properties": {
        "elapsed_millis": {"type": "integer", "minimum": 0},
        "process_count": {"type": "integer", "minimum": 0},
        "peak_memory_bytes": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0},
        "artifact_count": {"type": "integer", "minimum": 0}
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label", "value"],
          "properties": {
            "kind": {"const": "fact"},
            "label": {"$ref": "#/$defs/safe_code"},
            "value": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label", "value"],
          "properties": {
            "kind": {"const": "count"},
            "label": {"$ref": "#/$defs/safe_code"},
            "value": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label", "path", "sha256", "bytes"],
          "properties": {
            "kind": {"const": "digest"},
            "label": {"$ref": "#/$defs/safe_code"},
            "path": {"$ref": "#/$defs/artifact_path"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label", "value"],
          "properties": {
            "kind": {"const": "code"},
            "label": {"$ref": "#/$defs/safe_code"},
            "value": {"$ref": "#/$defs/safe_code"}
          }
        }
      ]
    }
  }
}
