{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peritus.invalid/schemas/security/native-candidate-v1.schema.json",
  "title": "Peritus H0 integrated candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {"$ref": "#/$defs/candidate"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_spec_id",
        "harness_id",
        "workspace_id",
        "workspace_generation",
        "workspace_revision",
        "policy_id",
        "provider_profile_id",
        "source_sha256",
        "release_manifest_sha256",
        "qualification_plan_sha256"
      ],
      "properties": {
        "acceptance_spec_id": {"$ref": "#/$defs/identifier"},
        "harness_id": {"$ref": "#/$defs/identifier"},
        "workspace_id": {"$ref": "#/$defs/identifier"},
        "workspace_generation": {"type": "integer", "minimum": 1},
        "workspace_revision": {"type": "integer", "minimum": 1},
        "policy_id": {"$ref": "#/$defs/identifier"},
        "provider_profile_id": {"$ref": "#/$defs/identifier"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "qualification_plan_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
