[Unit]
Description=Peritus local application daemon
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/peritusd supervise --config %h/.config/peritus/peritus.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=infinity
KillMode=mixed
UMask=0077

[Install]
WantedBy=default.target
