+            .expect("macOS");
+    let windows =
+        PlatformIdentity::new(OperatingSystem::Windows, Architecture::X86_64, support::digest(11))
+            .expect("windows");
+    let matrix = PlatformMatrix::new(linux, macos, windows).expect("platform matrix");
