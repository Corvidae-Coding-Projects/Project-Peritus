+            return Err(ContextError::node_numbers(
+                ContextErrorKind::TooManyDependencies,
+                id,
+                limits.max_dependencies_per_node() as u64,
+                dependencies.len() as u64,
+            ));
+        }
+        validation::validate_dependencies(id, &dependencies)?;
