+
+pub(super) proof fn acyclic_state_has_removable_node(
+    nodes: Seq<ContextNode>,
+    removed: Seq<bool>,
+)
+    requires
+        cycle_model::acyclic(nodes),
+        removed.len() == nodes.len(),
+        exists |index: int| 0 <= index < removed.len() && !removed[index],
