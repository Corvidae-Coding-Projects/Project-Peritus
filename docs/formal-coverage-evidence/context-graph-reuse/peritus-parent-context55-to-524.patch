+        })
+        .collect();
+    let error = ContextGraph::new(cycle, graph_limits).expect_err("long cycle is rejected");
+    assert_eq!(error.kind(), ContextErrorKind::DependencyCycle);
+    assert_eq!(error.node_id(), Some(id(1)));
+}
