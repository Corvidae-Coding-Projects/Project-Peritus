+    ) == 1);
+    reveal(cycle_model::node_depends_on);
+    assert(cycle_model::node_depends_on(nodes, source, target));
+    present_source_makes_remaining_positive(nodes, removed, target, source);
+    assert(before[target as int] > 0);
