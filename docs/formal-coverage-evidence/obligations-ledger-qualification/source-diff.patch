+                && supplied_evidence_verdict(ledger, candidate, &entry, evidence)
+                    != EvidenceVerdict::Satisfied
+            {
+                unsatisfied_requirements(ledger, candidate, entries, conditions, evidence)
+                    .push(entry.spec_id())
