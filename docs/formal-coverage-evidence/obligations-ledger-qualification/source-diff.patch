+                    && supplied_evidence_verdict(ledger, candidate, &entry, evidence)
+                        == EvidenceVerdict::Stale
+                { 1nat } else { 0nat },
+        invalid_count(ledger, candidate, entries.push(entry), conditions, evidence)
