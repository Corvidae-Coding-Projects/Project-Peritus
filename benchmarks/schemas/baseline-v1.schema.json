{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-peritus.invalid/schemas/h3/baseline-v1.json",
  "title": "Peritus accepted H3 baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "profile_id", "subject_revision", "evidence_digest", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref":"#/$defs/id"}, "profile_id": {"$ref":"#/$defs/id"},
    "subject_revision": {"type":"string","minLength":1,"maxLength":200},
    "evidence_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "entries": {"type":"array","minItems":1,"maxItems":512,"items":{"$ref":"#/$defs/entry"}}
  },
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":96,"pattern":"^[A-Za-z0-9._-]+$"},
    "entry": {
      "type":"object", "additionalProperties":false,
      "required":["workload_id","metric","statistic","value","sample_count"],
      "properties": {
        "workload_id":{"$ref":"#/$defs/id"}, "metric":{"type":"string","minLength":1},
        "statistic":{"enum":["minimum","mean","p50","p95","p99","maximum","total"]},
        "value":{"type":"integer","minimum":0}, "sample_count":{"type":"integer","minimum":1}
      }
    }
  }
}
