{
  "manifest_version": 3,
  "name": "Peritus Local Browser Bridge",
  "description": "Peritus browser control for loopback development pages and explicitly selected HTTPS source tabs.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://[::1]/*",
    "https://[::1]/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Peritus Local Browser Bridge",
    "default_popup": "popup.html"
  }
}
