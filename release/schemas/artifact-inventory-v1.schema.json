{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Corvidae-Coding-Projects/Project-Peritus/release/schemas/artifact-inventory-v1.schema.json",
  "title": "Peritus H4 artifact inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "binding": { "$ref": "release-binding-v1.schema.json" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byte_length", "sha256", "media_type", "roles"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "byte_length": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "media_type": { "type": "string", "minLength": 3, "maxLength": 120, "pattern": "^[!-~]+/[!-~]+$" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "executable", "distribution", "lifecycle-tool", "manifest", "sbom",
                "provenance", "signature", "license-notice", "migration-guide",
                "backup-guide", "restore-guide", "rollback-guide", "qualification-evidence"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[!-~]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
