{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Corvidae-Coding-Projects/Project-Peritus/release/schemas/signed-evidence-envelope-v1.schema.json",
  "title": "Peritus H4 detached-signature envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "binding", "kind", "disposition", "path", "byte_length", "payload_digest"],
  "properties": {
    "domain": { "const": "peritus/h4-signed-evidence/v1" },
    "binding": { "$ref": "release-binding-v1.schema.json" },
    "kind": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["satisfied", "not-satisfied"] },
    "path": { "type": "string", "minLength": 1, "maxLength": 512 },
    "byte_length": { "type": "integer", "minimum": 0 },
    "payload_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
