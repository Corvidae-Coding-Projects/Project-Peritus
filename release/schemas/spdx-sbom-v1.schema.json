{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Corvidae-Coding-Projects/Project-Peritus/release/schemas/spdx-sbom-v1.schema.json",
  "title": "Peritus deterministic SPDX 2.3 SBOM",
  "type": "object",
  "additionalProperties": false,
  "required": ["spdxVersion", "dataLicense", "SPDXID", "name", "documentNamespace", "creationInfo", "packages", "relationships", "releaseBinding"],
  "properties": {
    "spdxVersion": { "const": "SPDX-2.3" },
    "dataLicense": { "const": "CC0-1.0" },
    "SPDXID": { "const": "SPDXRef-DOCUMENT" },
    "name": { "type": "string", "minLength": 1 },
    "documentNamespace": { "type": "string", "minLength": 1 },
    "creationInfo": { "type": "object" },
    "packages": { "type": "array", "minItems": 1, "maxItems": 16384 },
    "relationships": { "type": "array", "minItems": 1, "maxItems": 16384 },
    "releaseBinding": { "$ref": "release-binding-v1.schema.json" }
  }
}
